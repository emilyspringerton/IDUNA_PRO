{
  "openapi": "3.0.3",
  "info": {
    "title": "CarePyre Community Tools -- Resume/CV Builder API",
    "version": "1.0.0",
    "description": "Real, machine-readable primitives over a user's own master resume (JSON Resume-shaped) and their named, bespoke Target resume variants -- built so an autonomous agent can bootstrap understanding of this API without reading Go source. Founder real-time, 2026-09-09: \"ensure that all of the features we have have good api because i am going to ask agents to work with those primitives to start intelligently managing the resume using agentic ai.\"\nEvery route below (except this document itself) requires a Bearer JWT carrying the `community-tools.access` permission, which is itself driven by a plain, per-account feature flag (`LocalUser.IsCommunityToolsEnabled`) -- not tied to any admin/provider tier. A caller can only ever read/write their OWN resume and targets; there is no cross-user admin-override path for this feature.\nTwo real update styles exist side by side: whole-document PUT (the original v0 shape -- simple, but an agent making one small edit must fetch, mutate, and resend everything) and real per-field/per-entry PATCH/POST/DELETE primitives (added specifically for agent ergonomics). Prefer the PATCH-style primitives for small, targeted edits.\nPATCH semantics: the request body only needs to include the fields being changed. A JSON key ABSENT from the body leaves that field's existing value untouched. A key PRESENT (including an explicit \"\" or []) overwrites it. For Target's own `summary_override`/ `label_override` fields specifically, an explicit `null` clears the override (a real, deliberate \"stop overriding this\" action) -- this is a genuine three-way distinction (absent / null / a real value), not just two.\n"
  },
  "servers": [
    {
      "url": "/api/v1/community-tools"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/resume": {
      "get": {
        "operationId": "getResume",
        "summary": "Fetch the caller's own master resume",
        "description": "Returns a real, valid, empty JSON Resume shell if the caller hasn't saved one yet -- never a 404. An empty resume is a valid starting state.\n",
        "responses": {
          "200": {
            "description": "The caller's own resume document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "put": {
        "operationId": "replaceResume",
        "summary": "Replace the caller's entire resume document",
        "description": "Whole-document replace. Any Work/Education/Skill/Award entry missing an `id` gets one server-assigned; an entry that already has an `id` keeps it. Prefer PATCH /resume/basics or the per-entry POST/PATCH/DELETE routes below for a small, targeted edit -- this route resends and re-persists the ENTIRE document every time.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Resume"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved resume, with server-assigned IDs filled in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/resume/basics": {
      "patch": {
        "operationId": "patchBasics",
        "summary": "Partially update just the Basics section",
        "description": "Merges the given fields onto the existing Basics -- every Work/Education/Skill/Award entry is left completely untouched. The most efficient primitive for e.g. fixing a phone number or tweaking the summary.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Basics"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The full resume after the merge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/resume/verify": {
      "post": {
        "operationId": "verifyResume",
        "summary": "Run itemized ATS-readability verification against the master resume",
        "description": "Real, itemized, named-rule results -- never a single opaque score. Built for exactly the \"verify, see which specific rule failed, fix it, re-verify\" loop an agent would run.\n",
        "responses": {
          "200": {
            "description": "Itemized verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/resume/export.pdf": {
      "get": {
        "operationId": "exportResumePDF",
        "summary": "Download a real, ATS-safe PDF of the master resume",
        "description": "A plain, single-column, genuinely selectable-text PDF (never an image). The response Content-Disposition header carries the real, sanitized filename to use.\n",
        "responses": {
          "200": {
            "description": "A real PDF file",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
