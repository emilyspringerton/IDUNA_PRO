      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Resume": {
        "type": "object",
        "description": "A direct, field-for-field mirror of the real JSON Resume schema (jsonresume.org).",
        "properties": {
          "basics": {
            "$ref": "#/components/schemas/Basics"
          },
          "work": {
