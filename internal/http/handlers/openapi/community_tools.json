            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "included_skill_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "included_award_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary_override": {
            "type": "string",
            "nullable": true,
            "description": "Overrides basics.summary in the resolved view. null/absent means unchanged."
          },
          "label_override": {
            "type": "string",
            "nullable": true,
            "description": "Overrides basics.label in the resolved view. null/absent means unchanged."
          },
          "included_profile_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
