          },
          "url": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "studyType": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "score": {
            "type": "string"
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Skill": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Award": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "awarder": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "Target": {
        "type": "object",
        "description": "A named, bespoke resume variant: a SELECTION over the master resume's own real Work/Education/Skill/Award entries (by id), plus two optional text overrides. Never a duplicate of the underlying data.\n",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
