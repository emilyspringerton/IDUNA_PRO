        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "description": "The employer's name."
          },
          "position": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "description": "YYYY, YYYY-MM, or YYYY-MM-DD"
          },
          "endDate": {
            "type": "string",
            "description": "YYYY, YYYY-MM, or YYYY-MM-DD; omitted means ongoing"
          },
          "summary": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
