            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "description": "A CarePyre extension beyond strict JSON Resume: id is a stable, server-assigned identifier a Target can reference. Multiple entries sharing the same network value (e.g. several distinct GitHub repo links) is real and expected.",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "network": {
            "type": "string",
            "description": "A free-text label, e.g. \"GitHub\" or \"LinkedIn\"."
